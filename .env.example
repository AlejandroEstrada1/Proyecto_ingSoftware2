# URL del backend. En el repo, `.env.development` ya apunta a 127.0.0.1:3001.
# Usa 127.0.0.1 (no solo "localhost") para evitar confusiones IPv4/IPv6 en Windows.
# VITE_API_URL=http://127.0.0.1:3001
#
# Proxy opcional de Vite (si no usas VITE_API_URL absoluta):
# VITE_PROXY_TARGET=http://127.0.0.1:3001
