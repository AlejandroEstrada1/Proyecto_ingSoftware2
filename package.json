{
  "name": "proyecto-adelanto-2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <27",
    "npm": ">=9"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "vite",
    "dev:api": "npm run dev --prefix backend",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "tests": "npm run tests:web && npm run tests:api",
    "tests:web": "jest --coverage --runInBand",
    "tests:api": "npm run tests --prefix backend",
    "tests:e2e": "playwright test",
    "testse2e": "npm run tests:e2e",
    "sonar": "sonar-scanner"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.3",
    "@babel/preset-react": "^7.28.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-jest": "^30.3.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "sonar-scanner": "^3.1.0",
    "vite": "^8.0.10"
  }
}
